{
  "sourceLanguage" : "en",
  "strings" : {
    "about.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A black strip is painted onto the wallpaper so the menu bar stays black.\n\nDynamic Wallpapers watches for picture changes and applies the strip automatically.\n\nVersion %1$@ (%2$@)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чёрная полоса рисуется на обоях, поэтому строка меню всегда чёрная.\n\n«Динамические обои» следит за сменой картинки и накладывает полосу автоматически.\n\nВерсия %1$@ (%2$@)"
          }
        }
      }
    },
    "about.title" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "О программе"
          }
        }
      }
    },
    "back" : {
