    "hideIcon.alert.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To show the icon in the menu bar again, open Inkbar from Applications or Spotlight."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы значок снова появился в строке меню, откройте Inkbar из папки «Программы» или Spotlight."
          }
        }
      }
